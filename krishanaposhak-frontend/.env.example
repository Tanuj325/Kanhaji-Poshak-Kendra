# ===================================================
# FRONTEND ENVIRONMENT CONFIGURATION (PUBLIC VALUES ONLY)
# ===================================================
# Note: VITE_* environment variables are embedded into the client-side JavaScript bundle.
# NEVER place server-side secrets (e.g. JWT secret, DB password, Razorpay secret, Cloudinary secret, SMTP credentials) in this file.

# Public API Base Endpoint URL
VITE_API_BASE_URL=http://localhost:9090
