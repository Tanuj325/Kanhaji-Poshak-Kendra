# =========================
# SERVER CONFIGURATION
# =========================
SERVER_PORT=9090

# =========================
# DATABASE CONFIGURATION
# =========================
DB_URL=jdbc:mysql://localhost:3306/krishanaposhak?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# =========================
# JWT AUTHENTICATION
# =========================
# Minimum 64 characters long secret string
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_long_for_hs512_security
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# =========================
# RAZORPAY PAYMENT GATEWAY
# =========================
RAZORPAY_API_KEY=your_razorpay_api_key_id
RAZORPAY_API_SECRET=your_razorpay_api_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key

# =========================
# FRONTEND CORS & ORIGINS
# =========================
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://kanhajiposhak.vercel.app

# =========================
# CLOUDINARY MEDIA STORAGE
# =========================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =========================
# SMTP EMAIL CONFIGURATION
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# =========================
# TOKEN EXPIRATION TIMES
# =========================
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=60
EMAIL_RESET_TOKEN_EXPIRY_MINUTES=30

# =========================
# RATE LIMITING SETTINGS
# =========================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# =========================
# BACKGROUND JOBS
# =========================
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_CRON=0 */15 * * * *
PAYMENT_RECONCILIATION_THRESHOLD_MINUTES=10

PAYMENT_CLEANUP_ENABLED=true
PAYMENT_CLEANUP_CRON=0 */30 * * * *
PAYMENT_CLEANUP_TIMEOUT_MINUTES=30

REFUND_RETRY_ENABLED=true
REFUND_RETRY_CRON=0 */15 * * * *
REFUND_RETRY_MAX_ATTEMPTS=5
REFUND_RETRY_BACKOFF_BASE_MINUTES=5
